{
  "name": "dsh-bw-router",
  "version": "0.2.4",
  "description": "B&W (小棒 & 灰狼) — DSH plugin: plan a task into stages, pick the right model per stage, and switch models inside one session without losing context.",
  "type": "module",
  "license": "MIT",
  "author": "B&W (小棒 & 灰狼)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bw",
    "model-router",
    "routing",
    "cost"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/plugin/client-entry.d.ts",
      "default": "./dist/client/client.js"
    },
    "./client-format": {
      "types": "./dist/plugin/client.d.ts",
      "import": "./dist/plugin/client.js"
    },
    "./dsh": {
      "types": "./dist/plugin/dsh-shell.d.ts",
      "import": "./dist/plugin/dsh-shell.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify:plan-trigger": "node scripts/verify-plan-trigger.mjs",
    "verify:dist-client": "node scripts/verify-dist-client.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "rolldown": "^1.2.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beidou6972yh/dsh-bw-router.git"
  },
  "bugs": {
    "url": "https://github.com/beidou6972yh/dsh-bw-router/issues"
  },
  "homepage": "https://github.com/beidou6972yh/dsh-bw-router#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@org/dsh-client-ui-conversation"
      ]
    }
  }
}
